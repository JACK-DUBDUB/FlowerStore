@model User
@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="account-card mt-3">
            <div class="text-center mb-4">
                <div style="font-size:2.1rem; margin-bottom:.25rem;">🌱</div>
                <h2 class="mb-1">Join @SiteSettings.Value.DisplayName</h2>
                <p class="text-muted small mb-0">Create an account to save orders and checkout in seconds</p>
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <form method="post" asp-antiforgery="true">
                <div class="mb-3">
                    <label class="form-label" asp-for="UserName">Display name</label>
                    <input asp-for="UserName" class="form-control" placeholder="Alex Rivera" required />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@email.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Create a password" required minlength="6" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    <div class="form-text text-muted small">Passwords must match</div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mt-2">Create account</button>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        Already have an account? 
                        <a asp-controller="Account" asp-action="Login" class="fw-semibold">Log in instead</a>
                    </small>
                </div>
            </form>
        </div>

        <p class="text-center text-muted mt-3 small">
            Your data stays in our MongoDB store. We'll never share it.
        </p>
    </div>
</div>