@{
    ViewData["Title"] = "About us";
}

<div class="row">
    <div class="col-lg-7">
        <h2 class="mb-3">@SiteSettings.Value.Name</h2>
        <p class="lead">We are a small collective of flower growers and florists based in Perth, Western Australia. Every bloom in our collection is grown by partners within 40 km of the city and cut to order.</p>

        <h5 class="mt-4 mb-2">Our promise</h5>
        <ul class="text-muted">
            <li>Seasonal, never flown-in flowers</li>
            <li>Same-day collection or next-day delivery across Perth metro</li>
            <li>Plastic-free wrapping on every order</li>
            <li>100% satisfaction — we’ll remake any arrangement that doesn’t make you smile</li>
        </ul>

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse flowers</a>
        </div>
    </div>
    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="account-card">
            <h6 class="mb-3">Grower locations</h6>
            <div class="small text-muted">
                Canning Vale • Willeton • Palmyra • Melville • Armadale • Fremantle • 
                Byford • Dianella • Applecross • Rockingham and more.
            </div>
            <div class="mt-3 pt-3 border-top" style="border-color:var(--border)">
                <div class="small">Questions? Reach us at <span class="text-white">@SiteSettings.Value.ContactEmail</span></div>
            </div>
        </div>
    </div>
</div>
