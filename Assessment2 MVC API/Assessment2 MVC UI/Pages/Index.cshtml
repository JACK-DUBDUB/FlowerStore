@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Display ALL PRODUCTS-->
<ul id="products-list"></ul>

@section Scripts {
    <script>
        let url = "https://localhost:7209/products/display_products"; // <-- this needs to match - use swagger if you need to check the url link
        let productsList = document.getElementById("products-list"); // <-- send to unordered dot point list

        fetch(url) // <-- Query a response from the url - if it didn't connect then display error - read console to find error 
            .then(response => response.json())
            .then(data => showProducts(data))
            .catch(ex => {
                alert("Error!");
                console.error(ex);
            });

        function showProducts(products) {
            products.forEach(product => {
                let li = document.createElement("li");
                let text = `${product.name} (\$${product.price})`; // <-- Display list item as text
                li.appendChild(
                    document.createTextNode(text));
                productsList.appendChild(li);
            });
        }
    </script>



}