@using Microsoft.AspNetCore.Authentication

<h2>Account Role</h2>

<dl> 
    @foreach (var role in User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)) // <-- The only case where i've gpt'd this section of the app. Ridiculous
    {
        <dt>@role.Type</dt>
        <dd>@role.Value</dd>
    }
</dl>

<h2>Claims</h2>

<dl>
    @foreach (var claim in User.Claims)
    {
        <dt>@claim.Type</dt>
        <dd>@claim.Value</dd>
    }
</dl>

<h2>Properties</h2>

<dl>
    @foreach (var prop in (await Context.AuthenticateAsync()).Properties.Items)
    {
        <dt>@prop.Key</dt>
        <dd>@prop.Value</dd>
    }
</dl>